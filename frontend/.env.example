# Next.js + Clerk + Sentry — environment template
# Copy to .env.local and fill real values. Do NOT commit secrets.

# ── Clerk (auth) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Backend API (BFF target) ────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Application routing ─────────────────────────────────────────────────────
# Sub-path prefix when the app is served from a base path ("" by default).
NEXT_PUBLIC_BASE_PATH=

# Demo mode mounts the app under /demo.
IS_DEMO=0

# ── Sentry (observability) — optional; empty DSN disables the SDK ───────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Misc ────────────────────────────────────────────────────────────────────
# Landing "developers" section demo key.
OPTIMUS_KEY=

# ── Playwright E2E (tests) ──────────────────────────────────────────────────
# Base URL the browser tests hit (default: http://localhost:3000).
PLAYWRIGHT_TEST_BASE_URL=
PORT=3000
# --- Clerk E2E (authenticated Playwright tests) ---
# When these are missing or empty, the signed-in E2E suite (tests/e2e/chat.signedin.spec.ts)
# SKIPS cleanly instead of failing. CLERK_SECRET_KEY and NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# must also be set (in .env.local) for the authenticated suite to run.
# E2E_CLERK_USER_EMAIL must exist on (or be creatable on) the Clerk dev instance;
# a `+clerk_test@example.com` address avoids real verification emails.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
