{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/backend/*": ["../backend/*"],
      "@/lib/db/*": ["../backend/db/*"],
      "@/lib/ai/*": ["../backend/ai/*"],
      "@/lib/artifacts/*": ["../backend/artifacts/*"],
      "@/lib/*": ["./lib/*"],
      "@/components/*": ["./components/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/lib/i18n": ["./i18n/index.tsx"],
      "@/lib/i18n/*": ["./i18n/*"],
      "@/lib/editor/*": ["./editor/*"],
      "@/frontend/*": ["./*"],
      "@/*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
