# ── Core ───────────────────────────────────────────────────────────────
# Postgres (Neon). DATABASE_URL is the pooled URL (app engine);
# DATABASE_URL_UNPOOLED is the direct URL (Alembic migrations).
DATABASE_URL=postgres://user:pass@host:5432/db
DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379/0

# ── Auth (Clerk) ──────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_DOMAIN=

# ── ARCA ───────────────────────────────────────────────────────────────
ESTUDIO_CUIT=20324837796
ESTUDIO_CLAVE_FISCAL=
ARCA_PROXY_URL=
CERT_DIR=.certificados-arca

# ── Browser (Composio) ─────────────────────────────────────────────────
COMPOSIO_API_KEY=

# ── Memory (Engram + Redis cache) ─────────────────────────────────────
MEMORY_ENGRAM_URL=http://localhost:7437
MEMORY_REDIS_CACHE_URL=redis://localhost:6379/0
MEMORY_REDIS_MAX_MB=25
MEMORY_ENGRAM_TIMEOUT=10

# ── Email (Resend — adapters/resend_email.py, default sender for API/worker) ──
RESEND_API_KEY=
EMAIL_FROM="Estudio Contable <reportes@tudominio.com>"

# ── SMTP (legacy — solo CLI batch vía clients.yaml, no usado por API/worker) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_BASE_URL=http://localhost:8000
