# ── Core ───────────────────────────────────────────────────────────────
# Postgres (Neon). DATABASE_URL is the pooled URL (app engine);
# DATABASE_URL_UNPOOLED is the direct URL (Alembic migrations).
DATABASE_URL=postgres://user:pass@host:5432/db
DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379/0

# ── Auth (Clerk) ──────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_DOMAIN=

# ── ARCA ───────────────────────────────────────────────────────────────
ESTUDIO_CUIT=20324837796
ESTUDIO_CLAVE_FISCAL=
ARCA_PROXY_URL=
CERT_DIR=.certificados-arca

# ── Feature flags (integrations) ────────────────────────────────────────
# External integrations are OFF by default (kill-switch): a disabled
# integration returns 503 INTEGRATION_DISABLED instead of touching the network.
# Enable explicitly for smoke runs / Fase 2 pilots.
ARCA_ENABLED=false
BROWSER_ENABLED=false
PDF_ENABLED=true

# ── Browser (Browserbase / Composio) ─────────────────────────────────
# BROWSER_PROVIDER selects the browser backend: browserbase (default) uses the
# Browserbase Agents API; composio uses the Composio cloud REST API;
# mock = deterministic local testing, no cloud.
# Allowed: composio|browserbase|mock.
BROWSER_PROVIDER=browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# BROWSER_SESSION_TTL_SECONDS: TTL (seconds) of the persisted Browserbase
# context (cookies del login ARCA) — expired contexts are not reused.
BROWSER_SESSION_TTL_SECONDS=3600
# BROWSER_SESSION_REUSE: reuse the persisted context so the next tool
# starts already logged in. Set false for ephemeral runs per tool.
BROWSER_SESSION_REUSE=true

# Composio (opt-in legacy provider): set BROWSER_PROVIDER=composio
# and provide a Composio API key.
COMPOSIO_API_KEY=

# ── Memory (Engram + Redis cache) ─────────────────────────────────────
MEMORY_ENGRAM_URL=http://localhost:7437
MEMORY_REDIS_CACHE_URL=redis://localhost:6379/0
MEMORY_REDIS_MAX_MB=25
MEMORY_ENGRAM_TIMEOUT=10

# ── Email (Resend — adapters/resend_email.py, default sender for API/worker) ──
RESEND_API_KEY=
EMAIL_FROM="Estudio Contable <reportes@tudominio.com>"

# ── SMTP (legacy — solo CLI batch vía clients.yaml, no usado por API/worker) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_BASE_URL=http://localhost:8000
